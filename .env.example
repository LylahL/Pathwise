# Copy to .env.local (git-ignored). Server-side only: never prefix with VITE_.

# Candidate analysis provider: "gemini" or "anthropic". If unset, it follows whichever key is set (Gemini first).
# AI_PROVIDER=gemini

# Google AI (Gemini) key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6JLrbgEKb7v7ofmFvwAzd_ip2MRFh6qrFcONv3tcWBwuw
# One model or a comma-separated list; later models are tried if an earlier one is retired (404) or overloaded (503).
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite

# Alternative: Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# PORT=8787
# PATHWISE_DB=data/pathwise.db
